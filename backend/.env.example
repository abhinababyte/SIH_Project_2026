# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database (relative path resolved from app/core/config.py; leave blank to use default)
# DATABASE_URL=sqlite:///path/to/hillshield.db

# CORS — comma-separated additional origins (the localhost regex always applies)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# JWT — REQUIRED in production. Generate a secure key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
